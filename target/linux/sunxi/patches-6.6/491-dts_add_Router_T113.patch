diff a/arch/arm/boot/dts/allwinner/sun8i-t113s-t113.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-t113.dts
--- /dev/null
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-t113.dts
@@ -0,0 +1,710 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// Copyright (C) 2025 spider.vc.
+
+/dts-v1/;
+
+#include "sun8i-t113s.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pwm/pwm.h>
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+    model = "T113 Router";
+    compatible = "relion,router-t113", "allwinner,sun8i-t113s";
+
+    aliases {
+        serial0 = &uart0;
+        serial1 = &uart4;
+        spi0 = &spi0;
+        ethernet0 = &emac;
+        i2c1 = &i2c1;
+        i2c2 = &i2c2;
+        i2c3 = &i2c3;
+    };
+
+    chosen {
+      stdout-path = "serial0:115200n8";
+    };
+
+    cpu_opp_table: cpu-opp-table {
+      compatible = "allwinner,sun20i-d1-operating-points", 
+                   "allwinner,sun50i-h6-operating-points";
+      nvmem-cells = <&cpu_speed_grade>;
+
+      opp-1080000000 {
+        opp-hz = /bits/ 64 <1008000000>;
+        opp-microvolt = <900000 950000 1100000>;
+      };
+    };
+
+    gpio-buttons {
+      compatible = "gpio-keys";
+
+      button-reset {
+        label = "reset";
+        linux,code = <KEY_RESTART>;
+        gpios = <&pio 4 12 GPIO_ACTIVE_LOW>; /* PE12 */
+        debounce-interval = <60>;
+      };
+    };
+
+    leds {
+        compatible = "gpio-leds";
+
+        mcu_led: led-0 {
+            gpios = <&pio 5 3 GPIO_ACTIVE_HIGH>; /* PF3 */
+            default-state = "on";
+            linux,default-trigger = "heartbeat";
+        };
+
+        led-1 {
+            gpios = <&pio 1 4 GPIO_ACTIVE_HIGH>; /* PB4 */
+            default-state = "off";
+        };
+
+        led-2 {
+            gpios = <&pio 1 5 GPIO_ACTIVE_HIGH>; /* PB5 */
+            default-state = "off";
+        };
+
+        led-3 {
+            gpios = <&pio 1 6 GPIO_ACTIVE_HIGH>; /* PB6 */
+            default-state = "off";
+        };
+
+        led-4 {
+            gpios = <&pio 1 7 GPIO_ACTIVE_HIGH>; /* PB7 */
+            default-state = "off";
+        };
+    };
+
+    soc {
+      pwm: pwm@2000c00 {
+          compatible = "allwinner,sun20i-d1-pwm";
+          reg = <0x2000c00 0x400>;
+          clocks = <&ccu CLK_BUS_PWM>, <&dcxo>, <&ccu CLK_APB0>;
+          clock-names = "bus", "hosc", "apb";
+          resets = <&ccu RST_BUS_PWM>;
+          interrupts = <SOC_PERIPHERAL_IRQ(18) IRQ_TYPE_LEVEL_HIGH>;
+          #pwm-cells = <2>;
+          status = "disabled";
+      };
+
+      ths0: cpu-temperature-sensor@2009400 {
+          compatible = "allwinner,sun20i-d1-ths";
+          reg = <0x2009400 0x400>;
+          clocks = <&ccu CLK_BUS_THS>, <&dcxo>;
+          clock-names = "bus", "hosc";
+          resets = <&ccu RST_BUS_THS>;
+          interrupts = <SOC_PERIPHERAL_IRQ(58) IRQ_TYPE_LEVEL_HIGH>;
+          nvmem-cells = <&ths_calib>;
+          nvmem-cell-names = "calibration";
+          #thermal-sensor-cells = <0>;
+      };
+    };
+
+    ths1: thermistor {
+		  compatible = "epcos,b57891s0103"; //b57891s0103 ~= NCP21XV103J03RA
+		  pullup-uv = <3300000>;
+		  pullup-ohm = <10000>;
+		  pulldown-ohm = <0>;
+		  io-channels = <&gpadc 0>;
+      #thermal-sensor-cells = <0>;
+	  };
+
+    fan0: pwm-fan {
+      compatible = "pwm-fan";
+      cooling-levels = <0 102 170 230 255>;
+      pwms = <&pwm 3 20000>; //PWM3 50kHz
+      #cooling-cells = <2>;
+      fan-supply = <&reg_vcc5v>;
+    };
+
+    thermal-zones {
+	    cpu_thermal: cpu-thermal {
+        polling-delay-passive = <250>; /* milliseconds */
+		    polling-delay = <1000>; /* milliseconds */
+        thermal-sensors = <&ths0>;
+
+        trips {
+          cpu_target_0: cpu-target-0 {
+              hysteresis = <3000>;
+              temperature = <85000>;
+              type = "passive";
+          };
+
+          cpu_crit_0: cpu-crit-0 {
+              hysteresis = <0>;
+              temperature = <110000>;
+              type = "critical";
+          };
+	      };
+
+        cooling-maps {
+          map0 {
+            trip = <&cpu_target_0>;
+            cooling-device = <&fan0 0 1>;
+          };
+        };
+	    };
+
+      board_thermal: board-thermal {
+        polling-delay-passive = <1000>; /* milliseconds */
+		    polling-delay = <2500>; /* milliseconds */
+        thermal-sensors = <&ths1>;
+
+        trips {
+            board_alert_0: board-alert-0 {
+                temperature = <100000>;
+                hysteresis = <1000>;
+                type = "passive";
+            };
+            board_crit_0: board-crit-0 {
+                temperature = <130000>;
+                hysteresis = <1000>;
+                type = "critical";
+            };
+        };
+      };
+    };
+
+    reg_vcc5v: regulator-5v {
+      compatible = "regulator-fixed";
+      regulator-name = "vcc-5v";
+      regulator-min-microvolt = <5000000>;
+      regulator-max-microvolt = <5000000>;
+      regulator-always-on;
+    };
+
+    reg_3v3: regulator-3v3 {
+      compatible = "regulator-fixed";
+      regulator-name = "vcc-3v3";
+      regulator-min-microvolt = <3300000>;
+      regulator-max-microvolt = <3300000>;
+      vin-supply = <&reg_vcc5v>;
+    };
+
+    reg_vcc_core: regulator-core {
+      compatible = "regulator-fixed";
+      regulator-name = "vcc-core";
+      regulator-min-microvolt = <950000>;
+      regulator-max-microvolt = <950000>;
+      vin-supply = <&reg_vcc5v>;
+    };
+
+    reg_vdd1v5: regulator-avdd {
+      compatible = "regulator-fixed";
+      regulator-name = "vdd1v5";
+      regulator-min-microvolt = <1500000>;
+      regulator-max-microvolt = <1500000>;
+      vin-supply = <&reg_vcc5v>;
+    };
+};
+
+&cpu0 {
+  cpu-supply = <&reg_vcc_core>;
+  clock-frequency = <1008000000>;
+  operating-points-v2 = <&cpu_opp_table>;
+  #cooling-cells = <0x02>;
+};
+
+&cpu1 {
+  cpu-supply = <&reg_vcc_core>;
+  clock-frequency = <1008000000>;
+  operating-points-v2 = <&cpu_opp_table>;
+  #cooling-cells = <0x02>;
+};
+
+&dcxo {
+  clock-frequency = <24000000>;
+};
+
+/*
+&ehci0 {
+  status = "okay";
+};
+*/
+&ehci1 {
+  status = "okay";
+};
+/*
+&ohci0 {
+  status = "okay";
+};
+*/
+&ohci1 {
+  status = "okay";
+};
+
+&i2c1 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&i2c1_pe01_pin>;
+  status = "okay";
+
+  ethernet-pse@22 {
+    compatible = "ti,tps23881";
+    reg = <0x22>;
+
+    channels {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      phys0: channel@0 {
+        reg = <0>;
+      };
+
+      phys1: channel@1 {
+        reg = <1>;
+      };
+
+      phys2: channel@2 {
+        reg = <2>;
+      };
+
+      phys3: channel@3 {
+        reg = <3>;
+      };
+
+      phys4: channel@4 {
+        reg = <4>;
+      };
+
+      phys5: channel@5 {
+        reg = <5>;
+      };
+
+      phys6: channel@6 {
+        reg = <6>;
+      };
+
+      phys7: channel@7 {
+        reg = <7>;
+      };
+    };
+
+    pse_pis {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      pse_pi0: pse_pi@0 {
+        reg = <0>;
+        #pse-cells = <0>;
+        pairset-names = "alternative-a", "alternative-b";
+        polarity-supported = "MDI", "MDI-X", "X", "S";
+        pairsets = <&phys0>, <&phys1>;
+      };
+
+      pse_pi1: pse_pi@1 {
+        reg = <1>;
+        #pse-cells = <0>;
+        pairset-names = "alternative-a", "alternative-b";
+        polarity-supported = "MDI", "MDI-X", "X", "S";
+        pairsets = <&phys2>, <&phys3>;
+      };
+
+      pse_pi2: pse_pi@2 {
+        reg = <2>;
+        #pse-cells = <0>;
+        pairset-names = "alternative-a", "alternative-b";
+        polarity-supported = "MDI", "MDI-X", "X", "S";
+        pairsets = <&phys4>, <&phys5>;
+      };
+
+      pse_pi3: pse_pi@3 {
+        reg = <3>;
+        #pse-cells = <0>;
+        pairset-names = "alternative-a", "alternative-b";
+        polarity-supported = "MDI", "MDI-X", "X", "S";
+        pairsets = <&phys6>, <&phys7>;
+      };
+    };
+  };
+};
+
+&i2c2 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&i2c2_pe45_pin>;
+  status = "okay";
+};
+
+&i2c3 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&i2c3_pe67_pin>;
+  status = "okay";
+};
+
+&pio {
+  vcc-pb-supply = <&reg_3v3>;
+  vcc-pc-supply = <&reg_3v3>;
+  vcc-pd-supply = <&reg_3v3>;
+  vcc-pe-supply = <&reg_3v3>;
+  vcc-pf-supply = <&reg_3v3>;
+  vcc-pg-supply = <&reg_3v3>;
+
+  gpio-line-names = 
+    "","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","", //PA? 1-31
+    "","",         //PB0-PB1? 32-33
+    "PB2 - USART4",//34
+    "PB3 - USART4",//35
+    "PB4 - led-1", //36
+    "PB5 - led-2", //37
+    "PB6 - led-3", //38
+    "PB7 - led-4", //39
+    "","","","","","","","","","","","","","","","","","","","","","","","","", //40-64
+    "",            //PC0? 65
+    "PC2 - CLK",   //66
+    "PC3 - CS",    //67
+    "PC4 - MOSI",  //68
+    "PC5 - MISO",  //69
+    "PC6",         //70
+    "PC7",         //71
+    "","","","","","","","","","","","","","","","","","","","","","","","", //72-95
+    "PD0",         //96
+    "PD1",         //97
+    "PD2",         //98
+    "PD3",         //99
+    "PD4",         //100
+    "PD5",         //101
+    "PD6",         //102
+    "PD7",         //103
+    "PD8",         //104
+    "PD9",         //105
+    "PD10",        //106
+    "PD11",        //107
+    "PD12",        //108
+    "PD13",        //109
+    "PD14",        //110
+    "PD15",        //111
+    "PD16",        //112
+    "PD17",        //113
+    "PD18",        //114
+    "PD19",        //115
+    "PD20",        //116
+    "PD21",        //117
+    "PD22",        //119
+    "","","","","","","","","", //120-128
+    "PE0 - I2C1",  //129
+    "PE1 - I2C1",  //130
+    "PE2",         //131
+    "PE3",         //132
+    "PE4 - I2C2",  //133
+    "PE5 - I2C2",  //134
+    "PE6 - I2C3",  //135
+    "PE7 - I2C3",  //136
+    "PE8",         //137
+    "PE9",         //138
+    "PE10",        //139
+    "PE11",        //140
+    "PE12",        //141
+    "PE13",        //142
+    "","","","","","","","","","","","","","","","","","", //143-159
+    "PF0",         //160
+    "PF1",         //161
+    "PF2 - USART0",//162
+    "PF3 - led-0", //163
+    "PF4 - USART0",//164
+    "PF5",         //165
+    "PF6",         //166
+    "","","","","","","","","","","","","","","","","","","","","","","","","","", //167-193
+    "PG0",         //194
+    "PG1",         //195
+    "PG2",         //196
+    "PG3",         //197
+    "PG4",         //198
+    "PG5",         //199
+    "PG6",         //200
+    "PG7",         //201
+    "PG8",         //202
+    "PG9",         //203
+    "PG10",        //204
+    "PG11",        //205
+    "PG12",        //206
+    "PG13",        //207
+    "PG14",        //208
+    "PG15"         //209
+    ;
+
+  spi0_cs_pin: spi0-cs-pin {
+      pins = "PC3";
+      function = "spi0";
+  };
+
+  spi0_pc67_pin: spi0-pc67-pin {
+      pins = "PC6", "PC7";
+      function = "spi0";
+  };
+
+  rgmii_pg_pins: rgmii-pg-pins {
+    pins = "PG0", "PG1", "PG2", "PG3", "PG4",
+           "PG5", "PG6", "PG7", "PG8", "PG9",
+           "PG10", "PG11", "PG12", "PG13",
+           "PG14", "PG15";
+    function = "emac";
+  };
+
+  uart0_pf_pins: uart0-pf-pins {
+    pins = "PF2", "PF4";
+    function = "uart0";
+  };
+
+  uart4_pb_pins: uart4-pf-pins {
+    pins = "PB2", "PB3";
+    function = "uart4";
+  };
+
+  pwm3_pd19_pin: pwm3-pd19-pin {
+    pins = "PD19";
+    function = "pwm3";
+    output-enable;
+  };
+
+  i2c1_pe01_pin: i2c1-pe01-pin {
+    pins = "PE0", "PE1";
+    function = "i2c1";
+  };
+
+  i2c2_pe45_pin: i2c2-pe45-pin {
+    pins = "PE4", "PE5";
+    function = "i2c2";
+  };
+
+  i2c3_pe67_pin: i2c3-pe67-pin {
+    pins = "PE6", "PE7";
+    function = "i2c3";
+  };
+};
+
+&spi0  {
+    pinctrl-0 = <&spi0_pins>, <&spi0_cs_pin>, <&spi0_pc67_pin>;
+    pinctrl-names = "default";
+    status = "okay";
+    flash@0 {
+        #address-cells = <1>;
+        #size-cells = <1>;
+        compatible = "spi-nand";
+        reg = <0>; /* Chip select 0 */
+        spi-max-frequency = <100000000>;
+        spi-tx-bus-width = <4>;
+        spi-rx-bus-width = <4>;
+        status = "okay";
+        partitions {
+            compatible = "fixed-partitions";
+            #address-cells = <1>;
+            #size-cells = <1>;
+            partition@u-boot {
+                 label = "u-boot";
+                 reg = <0x0 0x00080000>;
+            };
+            partition@u-boot-env {
+                label = "u-boot-env";
+                reg = <0x00080000 0x00020000>;
+            };
+            partition@firmware {
+                label = "firmware";
+                reg = <0x000A0000 0x0FF60000>;
+                compatible = "linux,ubi";
+                volumes {
+                  ubi-volume-kernel {
+                    volid = <0>;
+                    volname = "kernel";
+                  };
+                  ubi-volume-rootfs {
+                    volid = <1>;
+                    volname = "rootfs";
+                  };
+                  ubi-volume-rootfs_data {
+                    volid = <2>;
+                    volname = "rootfs_data";
+                  };
+                };
+            };
+        };
+    };
+};
+
+&mdio {
+  interrupt-parent = <&pio>;
+  interrupts = <5 6 IRQ_TYPE_LEVEL_LOW>; /* PF6 = INT_N */
+  interrupt-controller;
+  #interrupt-cells = <2>;
+
+  switch0: ethernet-switch@0 {
+    compatible = "marvell,mv88e6097";
+    reg = <0>;
+    reset-gpios = <&pio 5 5 GPIO_ACTIVE_LOW>; /* PF5 = RST_N */
+
+    ports {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      port@0 {
+          reg = <0>;
+          label = "lan0";
+      };
+
+      port@1{
+          reg = <1>;
+          label = "lan1";
+      };
+
+      port@2 {
+          reg = <2>;
+          label = "lan2";
+      };
+
+      port@3 {
+          reg = <3>;
+          label = "lan3";
+      };
+
+      port@7 {
+          reg = <7>;
+          label = "lan4";
+      };
+
+      port@8 {
+          reg = <8>;
+          label = "sfp0";
+      };
+
+      port@9 {
+          reg = <9>;
+          label = "sfp1";
+      };
+
+      port@10 { 
+          reg = <10>;
+          label = "cpu";
+          ethernet = <&emac>;
+          phy-mode = "rgmii-id";
+          fixed-link {
+            speed = <1000>;
+            full-duplex;
+          };
+      };
+    };
+  };
+};
+
+&emac {
+  pinctrl-names = "default";
+  pinctrl-0 = <&rgmii_pg_pins>;
+  reset-gpios = <&pio 5 5 GPIO_ACTIVE_LOW>; /* PF5 = RST_N */
+  phy-mode = "rgmii-id";
+  phy-handle = <&switch0>;
+  phy-supply = <&reg_3v3>;
+  clocks = <&ccu CLK_BUS_EMAC>, <&ccu CLK_EMAC_25M>;
+  clock-names = "stmmaceth", "phy";
+  status = "ok";
+
+  fixed-link {
+    speed = <1000>;
+    full-duplex;
+  };
+};
+
+&uart0 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&uart0_pf_pins>;
+  status = "okay";
+};
+
+&uart4 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&uart4_pb_pins>;
+  status = "okay";
+};
+
+&usb_otg {
+  dr_mode = "peripheral";
+  status = "okay";
+};
+
+&usbphy {
+  usb0_vbus-supply = <&reg_vcc5v>;
+  usb1_vbus-supply = <&reg_vcc5v>;
+  #reset-cells = <0>;
+  status = "okay";
+};
+
+&wdt {
+  status = "okay";
+};
+
+&ths0 {
+  status = "okay";
+};
+
+&rtc {
+  status = "okay";
+};
+
+&sid {
+  cpu_speed_grade: cpu-speed-grade@0 {
+	  eg = <0x0 0x2>;
+  };
+
+  ths_calib: ths-calib@14 {
+	  reg = <0x14 0x4>;
+  };
+};
+
+&pwm {
+//  allwinner,pwm-channels = <1>;
+  pinctrl-names = "default";
+	pinctrl-0 = <&pwm3_pd19_pin>;
+  status = "okay";
+};
+
+&syscon {
+  regulators@3000150 {
+				compatible = "allwinner,sun20i-d1-system-ldos";
+				reg = <0x3000150 0x4>;
+
+				reg_ldoa: ldoa {
+				};
+
+				reg_ldob: ldob {
+				};
+			};
+};
+
+&reg_ldoa {
+  regulator-name = "vcc-io";
+	regulator-always-on;
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+	ldo-in-supply = <&reg_3v3>;
+
+  regulator-state-mem {
+    regulator-on-in-suspend;
+  };
+};
+
+&reg_ldob {
+	regulator-name = "vcc-dram";
+	regulator-always-on;
+  regulator-min-microvolt = <1350000>;
+	regulator-max-microvolt = <1800000>;
+	ldo-in-supply = <&reg_3v3>;
+
+  regulator-state-mem {
+    regulator-on-in-suspend;
+  };
+};
+
+&gpadc {
+  #address-cells = <1>;
+  #size-cells = <0>;
+  status = "okay";
+
+  label = "board_temp";
+
+  channel@0 {
+    reg = <0>;
+  };
+};
+
diff a/arch/arm/boot/dts/allwinner/Makefile b/arch/arm/boot/dts/allwinner/Makefile
--- a/arch/arm/boot/dts/allwinner/Makefile	2025-09-01 12:52:51.541906418 +0600
+++ b/arch/arm/boot/dts/allwinner/Makefile	2025-08-25 12:59:43.014121328 +0600
@@ -255,6 +255,7 @@ dtb-$(CONFIG_MACH_SUN8I) += \
 	sun8i-s3-lichee-zero-plus.dtb \
 	sun8i-s3-pinecube.dtb \
 	sun8i-t113s-mangopi-mq-r-t113.dtb \
+	sun8i-t113s-t113.dtb \
 	sun8i-t3-cqa3t-bv3.dtb \
 	sun8i-v3-sl631-imx179.dtb \
 	sun8i-v3s-licheepi-zero.dtb \
