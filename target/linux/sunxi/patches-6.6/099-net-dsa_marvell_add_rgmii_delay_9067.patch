+int mv88e6097_port_set_rgmii_delay(struct mv88e6xxx_chip *chip, int port,
+				   phy_interface_t mode)
+{
+	dev_info(chip->dev, "p%d: RGMII delay \n", port);
+
+	if (port != 10)
+		return -EOPNOTSUPP;
+
+	u16 reg;
+	int err;
+
+	err = mv88e6xxx_port_read(chip, 6, 0x1A, &reg);
+
+	dev_info(chip->dev, "p%d: RGMII delay %x %d\n", port, reg, err);
+
+	if (err)
+		return err;
+
+	reg &= ~((1<<10) | (1<<9));
+
+	switch (mode) {
+	case PHY_INTERFACE_MODE_RGMII_RXID:
+		reg |= (1<<10);
+		break;
+	case PHY_INTERFACE_MODE_RGMII_TXID:
+		reg |= (1<<9);
+		break;
+	case PHY_INTERFACE_MODE_RGMII_ID:
+		reg |= (1<<10) | (1<<9);
+		break;
+	case PHY_INTERFACE_MODE_RGMII:
+		break;
+	default:
+		return 0;
+	}
+
+	err = mv88e6xxx_port_write(chip, 6, 0x1A, reg);
+
+	dev_info(chip->dev, "p%d: RGMII delay %x %d\n", port, reg, err);
+
+	if (err)
+		return err;
+
+	dev_dbg(chip->dev, "p%d: delay RXCLK %s, TXCLK %s\n", port,
+		reg & (1<<10) ? "yes" : "no",
+		reg & (1<<9) ? "yes" : "no");
+
+	return 0;
+}
