# apply a preset under /usr/share/usbgadget
config preset
        option name 'ether'
        # specify a UDC to enable this gadget:
        option UDC 'musb-hdrc.2.auto'

# or create a custom gadget here following the content of presets:
config gadget 'g1'
        option idVendor 0x1d6b
        option idProduct 0x0104
        option UDC 'musb-hdrc.2.auto'

config configuration 'c1'
        option gadget 'g1'
        option MaxPower 120

config function 'rn0'
        option configuration 'c1'
        option function 'rndis'
